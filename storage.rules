rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function nonAnonymousUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function staffDocument() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAuthorizedStaff() {
      return nonAnonymousUser()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && staffDocument().role == 'staff'
        && staffDocument().active == true;
    }

    function isPublishedProductImage(productId, fileName) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/publicMenu/$(productId)
        )
        && firestore.get(
          /databases/(default)/documents/publicMenu/$(productId)
        ).data.imagePath
          == 'product-images/' + productId + '/' + fileName;
    }

    function validImageWrite(productId, fileName) {
      return productId.size() > 0
        && productId.size() <= 120
        && fileName.matches('^[A-Za-z0-9-]+[.](jpg|png|webp)$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp'
        ];
    }

    match /product-images/{productId}/{fileName} {
      allow read: if isAuthorizedStaff()
        || isPublishedProductImage(productId, fileName);
      allow create, update: if isAuthorizedStaff()
        && validImageWrite(productId, fileName);
      allow delete: if isAuthorizedStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
